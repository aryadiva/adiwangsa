    {"id": "tasks_hrd_role", "label": "HRD Role & Camera-Only Capture", "file_type": "concept", "source_file": "/home/arya/Nextcloud/Adit/Documents/adiwangsa/TASKS.md", "source_location": "L371", "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "tasks_camera_only_capture", "label": "Camera-Only Live Capture Component", "file_type": "concept", "source_file": "/home/arya/Nextcloud/Adit/Documents/adiwangsa/TASKS.md", "source_location": "L375", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Filament's stock FileUpload cannot enforce camera-only. Needs custom Livewire/Alpine component using browser native camera capture API. Client-side enforcement is soft guarantee — pair with server-side check on embedded capture metadata (timestamp/recency) as defense in depth."},
    {"id": "tasks_worker_attendance", "label": "Worker Attendance (payroll source of truth)", "file_type": "concept", "source_file": "/home/arya/Nextcloud/Adit/Documents/adiwangsa/TASKS.md", "source_location": "L361", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "worker_attendance is the payroll source of truth; daily_report_workers is not. Don't accidentally wire payroll calculations to the SE's allocation Repeater data."},
