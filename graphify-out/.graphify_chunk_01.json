    {"id": "tasks_weight_validation", "label": "Weight Validation (incremental model)", "file_type": "concept", "source_file": "/home/arya/Nextcloud/Adit/Documents/adiwangsa/TASKS.md", "source_location": "L317", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Incremental model chosen over strict-100-on-each-save: individual weights may be any value and need not sum to 100 on each save, but validation rejects any save that pushes the set past 100% and blocks adding a new row once siblings already total 100%. Sets build up to exactly 100% and stop there. Guided by admin bell reminder rather than hard block."},
    {"id": "tasks_milestone_weight_notification_service", "label": "MilestoneWeightNotificationService", "file_type": "concept", "source_file": "/home/arya/Nextcloud/Adit/Documents/adiwangsa/TASKS.md", "source_location": "L320", "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "tasks_shift_based_daily_reports", "label": "Shift-Based Daily Reports", "file_type": "concept", "source_file": "/home/arya/Nextcloud/Adit/Documents/adiwangsa/TASKS.md", "source_location": "L325", "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "tasks_deficit_carry_forward_engine", "label": "Deficit Carry-Forward Engine", "file_type": "concept", "source_file": "/home/arya/Nextcloud/Adit/Documents/adiwangsa/TASKS.md", "source_location": "L330", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "daily_target is system-computed only (baseline + carried deficit). Scheduled job must run before day's shift reports are evaluated for warnings, or daily_target used for warning check will be stale. Warning notification fires once on first breach (first_triggered_at), not on repeat evaluation."},
    {"id": "tasks_delay_cascade_mitigation", "label": "Automated Delay Cascade & Mitigation Workflow", "file_type": "concept", "source_file": "/home/arya/Nextcloud/Adit/Documents/adiwangsa/TASKS.md", "source_location": "L336", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Delay-cascade date shift and sub_job_delay_events creation must happen atomically in one transaction — don't leave cascade as separate un-atomic follow-up step. A delay recorded without corresponding downstream date shift (or vice versa) leaves project timeline inconsistent with its own audit trail."},
    {"id": "tasks_sub_job_delay_event_state_machine", "label": "Sub-Job Delay Event State Machine (red→yellow→green)", "file_type": "concept", "source_file": "/home/arya/Nextcloud/Adit/Documents/adiwangsa/TASKS.md", "source_location": "L340", "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "tasks_client_portal_removal", "label": "Client Portal Removal & Emailed PDF Reports", "file_type": "concept", "source_file": "/home/arya/Nextcloud/Adit/Documents/adiwangsa/TASKS.md", "source_location": "L346", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removal of client Filament portal in favor of emailed PDF reports is deliberate, not an oversight. Client role retained as data record but no longer panel-accessible. Re-adding client panel/login routes requires explicit approval."},
