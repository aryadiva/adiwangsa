APP_NAME="Construction Ops Dashboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ---------------------------------------------------------------------------
# Database — PostgreSQL 15+
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=construction_ops
DB_USERNAME=postgres
DB_PASSWORD=secret

# ---------------------------------------------------------------------------
# Queue — Redis (required for PDF generation, notifications, image processing)
# ---------------------------------------------------------------------------
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
CACHE_STORE=redis
CACHE_PREFIX=construction_ops_cache_

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ---------------------------------------------------------------------------
# Mail — configure for notification emails (report published, revision requested, etc.)
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@construction-ops.local"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# File Storage — S3-compatible (AWS S3, DigitalOcean Spaces, MinIO for local dev)
# ---------------------------------------------------------------------------
# Photos and generated PDFs are stored here. Never use local disk in production.
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=construction-ops
AWS_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=http://localhost:9000/construction-ops

# ---------------------------------------------------------------------------
# PDF Generation — optional configuration for spatie/laravel-pdf or dompdf
# ---------------------------------------------------------------------------
PDF_DRIVER=spatie
# DOMPDF_ENABLE_REMOTE=true

# ---------------------------------------------------------------------------
# Filament Shield / Spatie Permission
# ---------------------------------------------------------------------------
# These are auto-configured by the packages, but override here if needed.
# SUPER_ADMIN_ROLE=admin
# FILAMENT_SHIELD_PREFIX=shield

# ---------------------------------------------------------------------------
# App-specific
# ---------------------------------------------------------------------------
# Default timezone for new projects (display conversion happens per-project)
APP_DEFAULT_TIMEZONE=UTC

# Maximum photo upload size in KB (10MB = 10240)
MAX_PHOTO_SIZE_KB=10240

# Signed URL expiry for photos and PDFs (in minutes)
SIGNED_URL_EXPIRY_MINUTES=60

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Laravel Sail (Docker) — uncomment if using Sail
# ---------------------------------------------------------------------------
# APP_PORT=80
# VITE_PORT=5173
# FORWARD_DB_PORT=5432
# FORWARD_REDIS_PORT=6379
# FORWARD_MAILPIT_PORT=1025
# FORWARD_MAILPIT_DASHBOARD_PORT=8025
# FORWARD_MINIO_PORT=9000
# FORWARD_MINIO_CONSOLE_PORT=8900
