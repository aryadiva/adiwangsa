APP_NAME="Construction Ops Dashboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ---------------------------------------------------------------------------
# Database — PostgreSQL (docker service hostname)
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=construction_ops
DB_USERNAME=sail
DB_PASSWORD=password

# ---------------------------------------------------------------------------
# Cache / Queue — Redis (docker service hostname)
# ---------------------------------------------------------------------------
CACHE_STORE=redis
CACHE_PREFIX=construction_ops_cache_
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ---------------------------------------------------------------------------
# Mail — Mailpit (docker service hostname)
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@construction-ops.local"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Object storage — S3-compatible / MinIO
# ---------------------------------------------------------------------------
# Photos and generated PDFs live on the S3-compatible 'photos'/'pdfs' disks.
# A SINGLE public host name must be reachable by BOTH the app containers (SDK
# API calls) AND the end-user's browser (signed preview/download URLs), because
# the AWS SDK signs presigned URLs against AWS_ENDPOINT.
#   - Docker Desktop:  host.docker.internal resolves on both the container and
#                      the host browser, so it works with zero setup.
#   - Native Linux:    point BOTH at your machine's LAN IP
#                      (http://<YOUR-LAN-IP>:9000) for photo/PDF previews.
#   - Real AWS S3:     leave AWS_ENDPOINT empty; AWS_URL = the bucket URL.
#   - Remote MinIO:    point BOTH at the public host proxying to MinIO.
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=sail
AWS_SECRET_ACCESS_KEY=password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=construction-ops
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://host.docker.internal:9000
AWS_URL=http://host.docker.internal:9000/construction-ops

# ---------------------------------------------------------------------------
# PDF generation
# ---------------------------------------------------------------------------
PDF_DRIVER=spatie

# ---------------------------------------------------------------------------
# App-specific
# ---------------------------------------------------------------------------
APP_DEFAULT_TIMEZONE=UTC
MAX_PHOTO_SIZE_KB=10240
SIGNED_URL_EXPIRY_MINUTES=60

# ---------------------------------------------------------------------------
# v0.2.0 — Client report email delivery (dummy/Mailpit transport; swap
# MAIL_MAILER/MAIL_HOST etc. above for production SMTP later — no code change)
# ---------------------------------------------------------------------------
REPORT_DEFAULT_SENDER_ADDRESS="reports@construction-ops.local"
REPORT_DEFAULT_SENDER_NAME="${APP_NAME}"
# Admin-configurable per send in the Filament UI; these are only fallback defaults.
REPORT_DEFAULT_CC=

# ---------------------------------------------------------------------------
# v0.2.0 — Target tracking & delay cascade defaults (overridable per project)
# ---------------------------------------------------------------------------
DEFAULT_DELAY_THRESHOLD_DAYS=2

# ---------------------------------------------------------------------------
# v0.2.0 — Payroll
# ---------------------------------------------------------------------------
PAYROLL_CYCLE_DAYS=14
STANDARD_WORKDAY_HOURS=8

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Vite (dev only)
# ---------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"